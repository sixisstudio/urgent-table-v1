{
  "manifest_version": 3,
  "name": "Urgent Table",
  "short_name": "UrgentTable",
  "version": "0.3.3",
  "description": "Detects which Hijack Poker table requires your action and (later) brings it into a fixed stage window. v0.3.3 ships the outgoing-frame fast-clear: urgency clears the instant hero clicks instead of waiting for the next inbound snapshot.",
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "webNavigation",
    "alarms",
    "system.display"
  ],
  "host_permissions": [
    "https://game.hijack.poker/*",
    "https://*.hijackpoker.com/*",
    "https://*.hijack.poker/*"
  ],
  "background": {
    "service_worker": "src/background/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Urgent Table"
  },
  "content_scripts": [
    {
      "matches": [
        "https://game.hijack.poker/*"
      ],
      "js": ["src/content/relay.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ]
}
